{
    "name": "starborne-gear-calculator",
    "version": "0.1.0",
    "type": "module",
    "private": true,
    "//dependencies": "Shipped runtime only — the browser bundle or a Netlify function. Build tooling, type-only packages and node-side script deps belong in devDependencies: `npm run audit` scans production deps only, so anything listed here widens the security gate to code we never ship.",
    "dependencies": {
        "@cloudinary/react": "^1.14.4",
        "@cloudinary/url-gen": "^1.22.0",
        "@modelcontextprotocol/sdk": "1.31.0",
        "@supabase/supabase-js": "^2.117.2",
        "canvas-confetti": "^1.9.4",
        "html-to-image": "^1.11.13",
        "jose": "^6.2.12",
        "lucide-react": "^0.577.0",
        "react": "^18.2.0",
        "react-dom": "^18.2.0",
        "react-helmet-async": "^2.0.5",
        "react-router-dom": "^7.18.4",
        "recharts": "^2.15.1",
        "uuid": "^14.0.1",
        "web-vitals": "^2.1.4",
        "zod": "^4.6.5"
    },
    "scripts": {
        "start": "vite",
        "build": "tsc && vite build",
        "serve": "vite preview",
        "test": "vitest",
        "test:ui": "vitest --ui",
        "test:coverage": "vitest run --coverage",
        "test:watch": "vitest watch",
        "lint": "eslint src netlify/functions --report-unused-disable-directives --max-warnings 0",
        "lint:fix": "eslint src netlify/functions --fix",
        "format": "prettier --write \"src/**/*.{ts,tsx,css,md}\" \"netlify/functions/**/*.ts\"",
        "format:check": "prettier --check \"src/**/*.{ts,tsx,css,md}\" \"netlify/functions/**/*.ts\"",
        "knip": "knip",
        "prepare": "husky install",
        "lint-staged": "lint-staged",
        "fetch-buffs": "tsx src/utils/dataUpdate/updateBuffsData.ts",
        "fetch:gear-icons": "tsx scripts/fetch-gear-icons.ts",
        "admin:import": "tsx scripts/admin-import.ts",
        "populate-targeting": "tsx scripts/populate-ship-targeting.ts",
        "e2e": "cd e2e && npm test",
        "e2e:headed": "cd e2e && npm run test:headed",
        "e2e:ui": "cd e2e && npm run test:ui",
        "e2e:install": "cd e2e && npm ci && npx playwright install --with-deps chromium",
        "audit:skills": "tsx scripts/auditSkills.ts",
        "trace:ship": "tsx scripts/traceShip.ts",
        "audit:kit-ledger": "tsx scripts/writeKitLedger.ts",
        "audit:interactions": "tsx scripts/auditInteractions.ts",
        "audit:placement-symmetry": "tsx scripts/auditPlacementSymmetry.ts",
        "audit:gated-buffs": "tsx scripts/auditGatedBuffs.ts",
        "fetch:ship-skills": "tsx scripts/fetch-ship-skills.ts",
        "fetch:ship-data": "tsx scripts/fetch-ship-data.ts",
        "build:catalogue-skills": "tsx scripts/build-catalogue-skills-csv.ts",
        "diff:skill-parse": "tsx scripts/diff-skill-parse.ts",
        "sync:catalogue": "tsx scripts/sync-unit-catalogue.ts",
        "restore:ship-templates": "tsx scripts/restore-ship-templates.ts",
        "audit": "node scripts/audit.mjs",
        "admin:inactive-accounts": "tsx scripts/inactive-accounts.ts",
        "release": "tsx scripts/release.ts"
    },
    "engines": {
        "node": ">=22"
    },
    "browserslist": {
        "production": [
            ">0.2%",
            "not dead",
            "not op_mini all"
        ],
        "development": [
            "last 1 chrome version",
            "last 1 firefox version",
            "last 1 safari version"
        ]
    },
    "devDependencies": {
        "@eslint/js": "^9.39.5",
        "@prerenderer/renderer-puppeteer": "^1.2.4",
        "@prerenderer/rollup-plugin": "^0.3.12",
        "@testing-library/jest-dom": "^6.9.1",
        "@testing-library/react": "^16.3.3",
        "@testing-library/user-event": "^14.6.7",
        "@types/canvas-confetti": "^1.9.0",
        "@types/jsdom": "^21.1.7",
        "@types/node": "^22.20.5",
        "@types/react": "^18.2.0",
        "@types/react-dom": "^18.2.0",
        "@types/uuid": "^10.0.0",
        "@vitejs/plugin-react-swc": "^3.11.0",
        "@vitest/coverage-v8": "^3.2.7",
        "autoprefixer": "^10.6.1",
        "dotenv": "^16.6.1",
        "eslint": "^9.39.5",
        "eslint-config-prettier": "^10.1.8",
        "eslint-import-resolver-typescript": "^4.4.5",
        "eslint-plugin-import": "^2.32.0",
        "eslint-plugin-react": "^7.37.5",
        "eslint-plugin-react-hooks": "^5.2.0",
        "eslint-plugin-react-refresh": "^0.5.7",
        "globals": "^17.13.0",
        "husky": "^8.0.3",
        "jsdom": "^25.0.1",
        "knip": "^6.39.0",
        "lint-staged": "^15.2.11",
        "node-fetch": "^3.3.2",
        "postcss": "^8.5.28",
        "prettier": "^3.9.9",
        "puppeteer": "^25.12.0",
        "semver": "^7.6.3",
        "supabase": "^2.119.0",
        "tailwindcss": "^3.4.19",
        "tsx": "^4.23.15",
        "typescript": "^5.9.3",
        "typescript-eslint": "^8.71.0",
        "vite": "^6.4.2",
        "vite-plugin-pwa": "^1.3.0",
        "vite-plugin-svgr": "^4.5.0",
        "vite-tsconfig-paths": "^5.1.4",
        "vitest": "^3.1.2"
    },
    "overrides": {
        "serialize-javascript": "^7.0.5",
        "esbuild": "^0.28.1"
    },
    "lint-staged": {
        "{src,netlify/functions}/**/*.{ts,tsx}": [
            "eslint --fix",
            "prettier --write"
        ],
        "src/**/*.{css,md}": [
            "prettier --write"
        ]
    }
}
